# Token elegido por JPMG para verificar el callback en Meta Developers.
WEBHOOK_VERIFY_TOKEN=

# Fallback exclusivo para el numero de prueba anterior a Embedded Signup.
# Los numeros incorporados por Embedded Signup usan el token cifrado de su WABA.
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

OPENAI_API_KEY=

# API y bot corren en el mismo VPS por defecto.
API_URL=http://localhost:3003
# Debe ser fuerte e identico a BOT_SECRET en api_john/.env.
BOT_SECRET=

PORT=3002
# Grúa, línea de denuncias y cuenta para transferir: cada organización las carga
# en Admin → Configuración (llegan con GET /bot/context). Estas variables solo se
# usan si la API no manda perfil (API vieja o JPMG antes de guardar el suyo).
TOW_TRUCK_PHONE=
# Línea de denuncias de la compañía (por defecto, la de Triunfo en constants/business.ts)
CLAIMS_PHONE=
# Cuenta para transferir una cuota (por defecto, la de Triunfo en constants/business.ts)
TRANSFER_ALIAS=
TRANSFER_CBU=
TRANSFER_HOLDER=
TRANSFER_BANK=

# Mantener false durante el alta y los smoke tests de Coexistence.
# Cambiar a true solamente despues de validar echoes, takeover e historial.
BOT_AUTOREPLY_ENABLED=false

# Modo "atiende una persona": el bot se corre solo cuando alguien de la oficina
# parece estar atendiendo el chat (contesto desde la app o la bandeja hace poco),
# con ventanas de tiempo. En false el unico criterio es si la conversacion esta
# tomada (botPaused): tomada no contesta, devuelta contesta.
BOT_PERSON_MODE_ENABLED=false

# Muestra "escribiendo…" mientras el bot prepara la respuesta. Tambien marca el
# mensaje como leido: en Coexistence eso lo marca leido en la app de WhatsApp
# Business del equipo. Por defecto apagado.
WHATSAPP_TYPING_INDICATOR=false

# Aviso de "conversacion finalizada por inactividad". Desde octubre 2026 Meta
# cobra cada mensaje; en false la sesion igual se cierra, sin enviar el aviso.
INACTIVITY_WARNING_ENABLED=true
