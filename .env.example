# Token elegido por JPMG para verificar el callback en Meta Developers.
WEBHOOK_VERIFY_TOKEN=

# Fallback exclusivo para el numero de prueba anterior a Embedded Signup.
# Los numeros incorporados por Embedded Signup usan el token cifrado de su WABA.
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

OPENAI_API_KEY=

# API y bot corren en el mismo VPS por defecto.
API_URL=http://localhost:3003
# Debe ser fuerte e identico a BOT_SECRET en api_john/.env.
BOT_SECRET=

PORT=3002
TOW_TRUCK_PHONE=

# Mantener false durante el alta y los smoke tests de Coexistence.
# Cambiar a true solamente despues de validar echoes, takeover e historial.
BOT_AUTOREPLY_ENABLED=false
